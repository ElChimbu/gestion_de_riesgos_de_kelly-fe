# API Endpoints
# Configure these variables with your backend API URLs

# Development (localhost)
# VITE_OPERATIONS_ENDPOINT=http://localhost:3001/api/operations
# VITE_FIXED_OPERATIONS_ENDPOINT=http://localhost:3001/api/fixed-operations
# VITE_FIXED_OPERATIONS_STATS_ENDPOINT=http://localhost:3001/api/fixed-operations/stats
# VITE_UPLOAD_ENDPOINT=http://localhost:3001/api/upload

# Production (Vercel)
VITE_OPERATIONS_ENDPOINT=https://gestion-de-riesgos-de-kelly-be.vercel.app/api/operations
VITE_FIXED_OPERATIONS_ENDPOINT=https://gestion-de-riesgos-de-kelly-be.vercel.app/api/fixed-operations
VITE_FIXED_OPERATIONS_STATS_ENDPOINT=https://gestion-de-riesgos-de-kelly-be.vercel.app/api/fixed-operations/stats
VITE_UPLOAD_ENDPOINT=https://gestion-de-riesgos-de-kelly-be.vercel.app/api/upload

# External API Endpoints
VITE_COINGECKO_MARKETS_URL=https://api.coingecko.com/api/v3/coins/markets
